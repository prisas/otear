<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Otear.Views.WelcomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Otear.Services"
    IsTabStop="False">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="620" Margin="32,72,32,32" Spacing="28" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="18">
                    <Image x:Name="LogoImage" Width="72" Height="72" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Otear" Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock Text="Drop a video or folder here, or open one to start watching."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource AccentButtonStyle}" Click="OnOpenFile" Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                            <TextBlock Text="Open file…" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnOpenFolder" Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="16" />
                            <TextBlock Text="Open folder…" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnOpenUrl" Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71B;" FontSize="16" />
                            <TextBlock Text="Open URL…" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="RecentSection" Spacing="8">
                    <Grid>
                        <TextBlock Text="Recent" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <HyperlinkButton HorizontalAlignment="Right" Content="Clear" Click="OnClearRecent" />
                    </Grid>
                    <ListView x:Name="RecentList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRecentClick"
                              Margin="-12,0,-12,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:RecentItem">
                                <Grid ColumnSpacing="14" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <FontIcon Glyph="&#xE714;" FontSize="18" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ProgressBar Value="{x:Bind Progress}" Maximum="100" Visibility="{x:Bind ProgressVisibility}" Margin="0,4,0,0" MaxWidth="200"
                                                     HorizontalAlignment="Left" Width="200" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Tag="{x:Bind Path}" Click="OnRemoveRecent" Width="32" Height="32" Padding="0"
                                            Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Remove from list">
                                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Click="OnSettings"
                Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
                <TextBlock Text="Settings" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
