<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Otear.Controls.SeekBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid x:Name="Root" Height="24" Background="Transparent"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" PointerMoved="OnPointerMoved"
          PointerPressed="OnPointerPressed" PointerReleased="OnPointerReleased"
          PointerCaptureLost="OnPointerCaptureLost">
        <Grid x:Name="Bar" Height="4" VerticalAlignment="Center">
            <Rectangle x:Name="TrackRect" RadiusX="2" RadiusY="2" Fill="{ThemeResource SeekTrackBrush}" />
            <Canvas x:Name="BufferCanvas" />
            <Rectangle x:Name="PlayedRect" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" Width="0"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <Canvas x:Name="TickCanvas" />
        </Grid>
        <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                 Fill="{ThemeResource SeekThumbBrush}" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="3"
                 Opacity="0" IsHitTestVisible="False">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="ThumbTransform" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Popup x:Name="HoverPopup" IsLightDismissEnabled="False">
            <Border x:Name="HoverCard" Padding="4" CornerRadius="8" IsHitTestVisible="False"
                    Background="{ThemeResource OscPopupBackgroundBrush}"
                    BorderBrush="{ThemeResource OscBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="2">
                    <Border x:Name="ThumbFrame" CornerRadius="5" Visibility="Collapsed" Background="Black">
                        <Image x:Name="ThumbImage" Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="HoverTime" HorizontalAlignment="Center" Margin="6,2,6,0"
                               FontWeight="SemiBold" FontSize="13" />
                    <TextBlock x:Name="HoverChapter" HorizontalAlignment="Center" Margin="6,0,6,2" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               MaxWidth="240" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
