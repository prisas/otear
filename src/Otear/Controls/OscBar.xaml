<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Otear.Controls.OscBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Otear.Controls"
    IsTabStop="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#C8FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5CFFFFFF" />
                    <SolidColorBrush x:Key="OscTextBrush" Color="#E6FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14000000" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0C000000" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#E4000000" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E4000000" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#9E000000" />
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5C000000" />
                    <SolidColorBrush x:Key="OscTextBrush" Color="#E4000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="OscButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
            <Style x:Key="OscIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="Panel"
            Background="{ThemeResource OscBackgroundBrush}"
            BorderBrush="{ThemeResource OscBorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="14,10,14,8"
            PointerEntered="OnPanelPointerEntered" PointerExited="OnPanelPointerExited"
            PointerPressed="OnPanelPressed" PointerMoved="OnPanelMoved" PointerReleased="OnPanelReleased"
            PointerCaptureLost="OnPanelCaptureLost">
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Grip in the top padding: drag it (or any empty part of the bar) to move the bar; double-click resets. -->
            <local:DragHandle x:Name="Grip" Width="72" Height="10" Margin="0,-10,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                              ToolTipService.ToolTip="Drag to move the control bar · double-click to put it back"
                              AutomationProperties.Name="Move control bar">
                <Border Width="32" Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{ThemeResource OscTextBrush}" Opacity="0.35" />
            </local:DragHandle>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Volume -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="2">
                    <Button x:Name="MuteButton" Style="{StaticResource OscButtonStyle}" Click="OnMute"
                            ToolTipService.ToolTip="Mute (M)" AutomationProperties.Name="Mute">
                        <FontIcon x:Name="MuteIcon" Style="{StaticResource OscIconStyle}" Glyph="&#xE995;" />
                    </Button>
                    <Slider x:Name="VolumeSlider" Width="92" Minimum="0" Maximum="130" StepFrequency="1"
                            VerticalAlignment="Center" IsThumbToolTipEnabled="True" IsTabStop="False"
                            ValueChanged="OnVolumeChanged" AutomationProperties.Name="Volume" />
                </StackPanel>

                <!-- Transport -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <Button x:Name="PreviousButton" Style="{StaticResource OscButtonStyle}" Click="OnPrevious"
                            ToolTipService.ToolTip="Previous (PgUp)" AutomationProperties.Name="Previous">
                        <FontIcon Style="{StaticResource OscIconStyle}" Glyph="&#xE892;" />
                    </Button>
                    <Button x:Name="BackButton" Style="{StaticResource OscButtonStyle}" Click="OnBack"
                            ToolTipService.ToolTip="Back 10 s (←)" AutomationProperties.Name="Back 10 seconds">
                        <FontIcon Style="{StaticResource OscIconStyle}" Glyph="&#xEB9E;" />
                    </Button>
                    <Button x:Name="PlayButton" Style="{StaticResource OscButtonStyle}" Width="44" Height="40" Click="OnPlayPause"
                            ToolTipService.ToolTip="Play / Pause (Space)" AutomationProperties.Name="Play">
                        <FontIcon x:Name="PlayIcon" FontSize="22" Glyph="&#xF5B0;" />
                    </Button>
                    <Button x:Name="ForwardButton" Style="{StaticResource OscButtonStyle}" Click="OnForward"
                            ToolTipService.ToolTip="Forward 10 s (→)" AutomationProperties.Name="Forward 10 seconds">
                        <FontIcon Style="{StaticResource OscIconStyle}" Glyph="&#xEB9D;" />
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource OscButtonStyle}" Click="OnNext"
                            ToolTipService.ToolTip="Next (PgDn)" AutomationProperties.Name="Next">
                        <FontIcon Style="{StaticResource OscIconStyle}" Glyph="&#xE893;" />
                    </Button>
                </StackPanel>

                <!-- Tracks, panels, fullscreen -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                    <Button x:Name="AudioButton" Style="{StaticResource OscButtonStyle}"
                            ToolTipService.ToolTip="Audio track" AutomationProperties.Name="Audio track">
                        <FontIcon Style="{StaticResource OscIconStyle}" Glyph="&#xE8D6;" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="AudioFlyout" Placement="Top" Opening="OnAudioFlyoutOpening" />
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="SubtitleButton" Style="{StaticResource OscButtonStyle}"
                            ToolTipService.ToolTip="Subtitles" AutomationProperties.Name="Subtitles">
                        <FontIcon Style="{StaticResource OscIconStyle}" Glyph="&#xED1E;" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="SubtitleFlyout" Placement="Top" Opening="OnSubtitleFlyoutOpening" />
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="SpeedButton" Style="{StaticResource OscButtonStyle}" Width="44"
                            ToolTipService.ToolTip="Playback speed ([ ])" AutomationProperties.Name="Playback speed">
                        <TextBlock x:Name="SpeedText" Text="1×" FontSize="13" FontWeight="SemiBold" />
                        <Button.Flyout>
                            <Flyout x:Name="SpeedFlyout" Placement="Top" Opening="OnSpeedFlyoutOpening" Opened="OnSpeedFlyoutOpened">
                                <StackPanel Width="300" Spacing="8">
                                    <Grid>
                                        <TextBlock Text="Playback speed" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SpeedValueText" Text="1.00×" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Padding="8" Click="OnSlower" ToolTipService.ToolTip="0.05× slower ([)" AutomationProperties.Name="Slower">
                                            <FontIcon Glyph="&#xE738;" FontSize="12" />
                                        </Button>
                                        <Slider x:Name="SpeedSlider" Grid.Column="1" VerticalAlignment="Center"
                                                Minimum="0.25" Maximum="4" StepFrequency="0.05" SmallChange="0.05" LargeChange="0.25"
                                                IsThumbToolTipEnabled="False" ValueChanged="OnSpeedSliderChanged"
                                                AutomationProperties.Name="Playback speed" />
                                        <Button Grid.Column="2" Padding="8" Click="OnFaster" ToolTipService.ToolTip="0.05× faster (])" AutomationProperties.Name="Faster">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                    <Grid x:Name="SpeedPresets" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="QuickSettingsButton" Style="{StaticResource OscButtonStyle}" Click="OnQuickSettings"
                            ToolTipService.ToolTip="Video, audio &amp; subtitle settings" AutomationProperties.Name="Quick settings">
                        <FontIcon Style="{StaticResource OscIconStyle}" Glyph="&#xE9E9;" />
                    </Button>
                    <Button x:Name="PlaylistButton" Style="{StaticResource OscButtonStyle}" Click="OnPlaylist"
                            ToolTipService.ToolTip="Playlist &amp; chapters" AutomationProperties.Name="Playlist">
                        <FontIcon Style="{StaticResource OscIconStyle}" Glyph="&#xE8FD;" />
                    </Button>
                    <Button x:Name="FullscreenButton" Style="{StaticResource OscButtonStyle}" Click="OnFullscreen"
                            ToolTipService.ToolTip="Full screen (F)" AutomationProperties.Name="Full screen">
                        <FontIcon x:Name="FullscreenIcon" Style="{StaticResource OscIconStyle}" Glyph="&#xE740;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Seek row -->
            <Grid Grid.Row="1" ColumnSpacing="10" Margin="2,0,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ElapsedText" Text="0:00" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center"
                           FontSize="12" Foreground="{ThemeResource OscTextBrush}" />
                <local:SeekBar x:Name="Seek" Grid.Column="1" VerticalAlignment="Center" />
                <Button x:Name="RemainingButton" Grid.Column="2" Click="OnToggleRemaining" Padding="4,2" MinWidth="52" Height="24"
                        CornerRadius="4" BorderThickness="0" IsTabStop="False"
                        ToolTipService.ToolTip="Show remaining / total time">
                    <TextBlock x:Name="RemainingText" Text="0:00" FontSize="12" Foreground="{ThemeResource OscTextBrush}" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
