<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Otear.Controls.QuickSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,12,0,2" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="8,6,6,0">
            <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Name="VideoTab" Text="Video" IsSelected="True" />
                <SelectorBarItem x:Name="AudioTab" Text="Audio" />
                <SelectorBarItem x:Name="SubtitleTab" Text="Subtitles" />
            </SelectorBar>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnClose" Width="32" Height="32" Padding="0"
                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Close" AutomationProperties.Name="Close">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="16,0,16,16" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- VIDEO -->
                <StackPanel x:Name="VideoPage" Spacing="6">
                    <TextBlock Text="Track" Style="{StaticResource SectionHeader}" />
                    <ComboBox x:Name="VideoTrackBox" HorizontalAlignment="Stretch" SelectionChanged="OnVideoTrackChanged" />

                    <TextBlock Text="Aspect ratio" Style="{StaticResource SectionHeader}" />
                    <ComboBox x:Name="AspectBox" HorizontalAlignment="Stretch" SelectionChanged="OnAspectChanged" />

                    <Grid ColumnSpacing="8" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RotationText" Text="Rotation: 0°" Style="{StaticResource RowLabel}" />
                        <Button Grid.Column="1" Click="OnRotateLeft" ToolTipService.ToolTip="Rotate left" AutomationProperties.Name="Rotate left">
                            <FontIcon Glyph="&#xE7AD;" FontSize="14" RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform>
                            </FontIcon>
                        </Button>
                        <Button Grid.Column="2" Click="OnRotateRight" ToolTipService.ToolTip="Rotate right" AutomationProperties.Name="Rotate right">
                            <FontIcon Glyph="&#xE7AD;" FontSize="14" />
                        </Button>
                    </Grid>

                    <ToggleSwitch x:Name="DeinterlaceSwitch" Header="Deinterlace" Toggled="OnDeinterlaceToggled" />
                    <ToggleSwitch x:Name="HwdecSwitch" Header="Hardware decoding" Toggled="OnHwdecToggled" />

                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Speed" Style="{StaticResource SectionHeader}" Margin="0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <TextBlock x:Name="SpeedValueText" Text="1.00×" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <HyperlinkButton Content="Reset" Click="OnResetSpeed" Padding="4,0" />
                        </StackPanel>
                    </Grid>
                    <Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="4" StepFrequency="0.05" SmallChange="0.05" LargeChange="0.25"
                            IsThumbToolTipEnabled="False" ValueChanged="OnSpeedChanged" AutomationProperties.Name="Playback speed" />

                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Picture" Style="{StaticResource SectionHeader}" Margin="0" />
                        <HyperlinkButton HorizontalAlignment="Right" Content="Reset" Click="OnResetEqualizer" Padding="4,0" />
                    </Grid>
                    <StackPanel x:Name="EqualizerRows" Spacing="0" />

                    <TextBlock Text="Information" Style="{StaticResource SectionHeader}" />
                    <TextBlock x:Name="VideoInfo" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
                </StackPanel>

                <!-- AUDIO -->
                <StackPanel x:Name="AudioPage" Spacing="6" Visibility="Collapsed">
                    <TextBlock Text="Track" Style="{StaticResource SectionHeader}" />
                    <ComboBox x:Name="AudioTrackBox" HorizontalAlignment="Stretch" SelectionChanged="OnAudioTrackChanged" />

                    <TextBlock Text="Output device" Style="{StaticResource SectionHeader}" />
                    <ComboBox x:Name="AudioDeviceBox" HorizontalAlignment="Stretch" SelectionChanged="OnAudioDeviceChanged" />

                    <Grid Margin="0,8,0,0">
                        <TextBlock x:Name="AudioDelayText" Text="Delay: 0 ms" Style="{StaticResource SectionHeader}" Margin="0" />
                        <HyperlinkButton HorizontalAlignment="Right" Content="Reset" Click="OnResetAudioDelay" Padding="4,0" />
                    </Grid>
                    <Slider x:Name="AudioDelaySlider" Minimum="-5" Maximum="5" StepFrequency="0.05" ValueChanged="OnAudioDelayChanged" />

                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Equalizer" Style="{StaticResource SectionHeader}" Margin="0" />
                        <HyperlinkButton HorizontalAlignment="Right" Content="Reset" Click="OnResetAudioEq" Padding="4,0" />
                    </Grid>
                    <Grid x:Name="AudioEqGrid" Height="170" ColumnSpacing="0" />
                </StackPanel>

                <!-- SUBTITLES -->
                <StackPanel x:Name="SubtitlePage" Spacing="6" Visibility="Collapsed">
                    <TextBlock Text="Track" Style="{StaticResource SectionHeader}" />
                    <ComboBox x:Name="SubtitleTrackBox" HorizontalAlignment="Stretch" SelectionChanged="OnSubtitleTrackChanged" />
                    <TextBlock Text="Secondary track" Style="{StaticResource SectionHeader}" />
                    <ComboBox x:Name="SecondaryTrackBox" HorizontalAlignment="Stretch" SelectionChanged="OnSecondaryTrackChanged" />
                    <Button Content="Load subtitle file…" Click="OnLoadSubtitle" Margin="0,6,0,0" />

                    <Grid Margin="0,8,0,0">
                        <TextBlock x:Name="SubDelayText" Text="Delay: 0 ms" Style="{StaticResource SectionHeader}" Margin="0" />
                        <HyperlinkButton HorizontalAlignment="Right" Content="Reset" Click="OnResetSubDelay" Padding="4,0" />
                    </Grid>
                    <Slider x:Name="SubDelaySlider" Minimum="-10" Maximum="10" StepFrequency="0.1" ValueChanged="OnSubDelayChanged" />

                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Size" Style="{StaticResource SectionHeader}" Margin="0" />
                        <HyperlinkButton HorizontalAlignment="Right" Content="Reset" Click="OnResetSubScale" Padding="4,0" />
                    </Grid>
                    <Slider x:Name="SubScaleSlider" Minimum="0.5" Maximum="3" StepFrequency="0.05" ValueChanged="OnSubScaleChanged" />

                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Vertical position" Style="{StaticResource SectionHeader}" Margin="0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <TextBlock x:Name="SubPosText" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <HyperlinkButton Content="Reset" Click="OnResetSubPos" Padding="4,0" />
                        </StackPanel>
                    </Grid>
                    <!-- Reversed like in Settings: bottom on the left, dragging right raises the subtitles. -->
                    <Slider x:Name="SubPosSlider" Minimum="0" Maximum="100" StepFrequency="1" IsDirectionReversed="True"
                            IsThumbToolTipEnabled="False" ValueChanged="OnSubPosChanged" AutomationProperties.Name="Subtitle position" />

                    <ToggleSwitch x:Name="AssOverrideSwitch" Header="Use my subtitle style for styled (ASS) subtitles" Toggled="OnAssOverrideToggled" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
